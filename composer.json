{
  "name": "pronomix-gmbh/bookstack-ai-sync",
  "description": "BookStack to OpenWebUI knowledge sync package",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^9.0|^10.0",
    "illuminate/http": "^9.0|^10.0",
    "illuminate/database": "^9.0|^10.0",
    "illuminate/console": "^9.0|^10.0",
    "illuminate/queue": "^9.0|^10.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "orchestra/testbench": "^7.0|^8.0",
    "phpunit/phpunit": "^9.6|^10.0"
  },
  "autoload": {
    "psr-4": {
      "Pronomix\\BookStackOpenWebUISync\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pronomix\\BookStackOpenWebUISync\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pronomix\\BookStackOpenWebUISync\\BookStackOpenWebUISyncServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
